---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import Wave from '../components/Wave.astro';
import { md, mdInline } from '../lib/md';

const home = (await getEntry('singles', 'home'))!.data;
const { hero, intro, services, callout } = home;
---
<Base description={home.description}>
  <section class="hero">
    <div class="photo" style={`background-image:url('${hero.image}')`} aria-hidden="true"></div>
    <div class="content">
      <h1>{hero.heading}<br /><span class="decorative">{hero.script_heading}</span></h1>
      <div class="prose" set:html={md(hero.text)} />
      <Button href={hero.button_url} label={hero.button_label} />
    </div>
    <Wave />
  </section>

  <section class="home-intro">
    <div class="container wide">
      <div>
        <h2 set:html={mdInline(intro.heading)} />
        <p class="button-center"><Button href={intro.button_url} label={intro.button_label} /></p>
      </div>
      <div><img src={intro.image} alt="" width="747" height="708" /></div>
    </div>
  </section>

  <section class="home-services">
    <div class="bg" style={`background-image:url('${services.background_image}')`} aria-hidden="true"></div>
    <Wave class="top" /><Wave class="bottom" />
    <div class="container wide">
      <h2>{services.heading} <span class="decorative">{services.script_heading}</span></h2>
      <ul class="service-icons">
        {services.items.map((it: any) => (
          <li><a href={it.url}><h3>{it.title}</h3><img src={it.icon} alt="" loading="lazy" /></a></li>
        ))}
      </ul>
      <Button href={services.button_url} label={services.button_label} />
    </div>
  </section>

  <Callout {...callout} />
</Base>
